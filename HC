#include <iostream>   // Подключаем библиотеку для ввода/вывода
#include <string>     // Подключаем библиотеку для работы со строками
#include <map>        // Подключаем библиотеку для работы с ассоциативными контейнерами (map)
using namespace std;  // Используем пространство имен std для упрощения записи

// Функция для преобразования римского числа в десятичное
int romanToInt(string s) {
    // Создаем карту (словарь), в которой храним значения римских цифр
    map<char, int> values = {
        {'I', 1}, {'V', 5}, {'X', 10}, {'L', 50},
        {'C', 100}, {'D', 500}, {'M', 1000}
    };

    int result = 0;  // Переменная для хранения итогового числа

    // Перебираем все символы строки (римское число)
    for (int i = 0; i < s.length(); i++) {
        // Если текущий символ меньше следующего, то вычитаем его значение
        // (например, в "IV" символ 'I' меньше 'V', и мы вычитаем его)
        if (i + 1 < s.length() && values[s[i]] < values[s[i + 1]]) {
            result -= values[s[i]];  // Вычитаем значение текущей цифры
        } else {
            // Иначе, просто добавляем значение текущей цифры
            result += values[s[i]];  // Прибавляем значение текущей цифры
        }
    }

    return result;  // Возвращаем итоговое десятичное число
}

int main() {
    string roman;  // Строка для ввода римского числа

    // Запрашиваем у пользователя ввод римского числа
    cout << "Введите римское число: ";
    cin >> roman;  // Считываем введенное римское число

    // Выводим результат преобразования в десятичное число
    cout << "Десятичное число: " << romanToInt(roman) << endl;

    return 0;  // Завершаем программу
}
