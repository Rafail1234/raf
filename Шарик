#include <iostream>
#include <string>			
using namespace std;

class Animal{
private:
	string name:
public:
	   void init(const string & animalName){
		name=animalName;
	}
    	void bark()const{
		 for(int i=0;i<3;++i)
		  cout<<name<<"гав-гав"<<endl;
	}
	string getName()const{
		return name;
	}
};
int main(){
	Animal dog;
	dog.init("Шарик");
	dog.bark();
	return 0;
}
