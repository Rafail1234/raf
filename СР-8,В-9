#include <iostream>
#include <iomanip>
#include <string>

using namespace std;

struct Product {
	string name;       // наименование
	string code;       // числовой шифр
	double price;      // цена за единицу
	double quantity;   // количество
	string unit;       // единица измерения
	double totalCost;  // стоимость позиции
};

void calculateTotal(Product &p) {
	p.totalCost = p.price * p.quantity;
}

void printProduct(const Product &p) {
	cout << left << setw(15) << p.name
	<< setw(10) << p.code
	<< setw(8) << p.price
	<< setw(8) << p.quantity
	<< setw(5) << p.unit
	<< setw(10) << p.totalCost << endl;
}

// Пузырьковая сортировка по наименованию
void sortByName(Product products[], int n) {
	for (int i = 0; i < n - 1; i++) {
		for (int j = 0; j < n - 1 - i; j++) {
			if (products[j].name > products[j + 1].name) {
				Product temp = products[j];
				products[j] = products[j + 1];
				products[j + 1] = temp;
			}
		}
	}
}

// Пузырьковая сортировка по стоимости
void sortByTotalCost(Product products[], int n) {
	for (int i = 0; i < n - 1; i++) {
		for (int j = 0; j < n - 1 - i; j++) {
			if (products[j].totalCost > products[j + 1].totalCost) {
				Product temp = products[j];
				products[j] = products[j + 1];
				products[j + 1] = temp;
			}
		}
	}
}

int main() {
	const int n = 4;
	Product products[n] = {
		{"Apple", "123", 2.5, 3, "kg"},
		{"Milk", "456", 1.2, 2, "l"},
		{"Bread", "789", 1.5, 5, "pcs"},
		{"Cheese", "321", 10.0, 1, "kg"}
	};
	
	// Рассчитаем стоимость каждой позиции и общую сумму
	double grandTotal = 0;
	for (int i = 0; i < n; i++) {
		calculateTotal(products[i]);
		grandTotal += products[i].totalCost;
	}
	
	// Вывод таблицы
	cout << left << setw(15) << "Name"
	<< setw(10) << "Code"
	<< setw(8) << "Price"
	<< setw(8) << "Qty"
	<< setw(5) << "Unit"
	<< setw(10) << "Total" << endl;
	cout << "------------------------------------------------------" << endl;
	for (int i = 0; i < n; i++) {
		printProduct(products[i]);
	}
	cout << "------------------------------------------------------" << endl;
	cout << "Grand Total: " << grandTotal << endl << endl;
	
	// Поиск по шифру
	string searchCode;
	cout << "Enter code to search: ";
	cin >> searchCode;
	bool found = false;
	for (int i = 0; i < n; i++) {
		if (products[i].code == searchCode) {
			cout << "Found product: ";
			printProduct(products[i]);
			found = true;
			break;
		}
	}
	if (!found) cout << "Product not found!" << endl;
	
	// Сортировка по наименованию
	sortByName(products, n);
	cout << "\nSorted by name:\n";
	for (int i = 0; i < n; i++) printProduct(products[i]);
	
	// Сортировка по стоимости
	sortByTotalCost(products, n);
	cout << "\nSorted by total cost:\n";
	for (int i = 0; i < n; i++) printProduct(products[i]);
	
	return 0;
}
