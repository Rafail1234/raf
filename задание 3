#include <iostream>       // подключаем библиотеку для ввода/вывода (cout, cin)
using namespace std;      // чтобы не писать std:: перед cout и cin

int main() {
    setlocale(LC_ALL, "Russian"); // настройка русской локали для корректного вывода текста на русском

    int num1, num2;      // создаём две переменные для хранения введённых чисел

    // Просим пользователя ввести первое число
    cout << "Введите первое число: ";
    cin >> num1;         // считываем число с клавиатуры и сохраняем в num1

    // Просим пользователя ввести второе число
    cout << "Введите второе число: ";
    cin >> num2;         // считываем число с клавиатуры и сохраняем в num2

    // Сравниваем числа
    if (num1 == num2) {                  // проверяем, равны ли числа
        cout << "Числа равны" << endl;  // если равны, выводим сообщение
    }
    else if (num1 < num2) {              // если первое число меньше второго
        cout << "Первое число меньше второго" << endl; // выводим сообщение
    }
    else {                               // во всех остальных случаях (первое число больше второго)
        cout << "Первое число больше второго" << endl; // выводим сообщение
    }

    return 0;  // программа завершилась успешно
}
