#include <iostream>  // Подключаем библиотеку для ввода и вывода данных
using namespace std;  // Используем пространство имен std, чтобы не писать std:: перед стандартными функциями и типами

int main() {  // Главная функция, с которой начинается выполнение программы
    int num1, num2;  // Объявляем две переменные типа int для хранения введенных пользователем чисел
    cout << "Введите два числа: ";  // Выводим пользователю приглашение ввести два числа
    cin >> num1 >> num2;  // Считываем два числа, введенные пользователем, и сохраняем их в переменные num1 и num2

    // Начинаем условный оператор if-else, чтобы сравнить два числа

    if (num1 == num2) {  // Проверяем, равны ли два числа
        cout << "Числа равны." << endl;  // Если числа равны, выводим сообщение "Числа равны"
    } else if (num1 < num2) {  // Если числа не равны, проверяем, меньше ли первое число второго
        cout << "Первое число меньше второго." << endl;  // Если первое число меньше второго, выводим соответствующее сообщение
    } else {  // Если оба предыдущих условия не сработали, значит первое число больше второго
        cout << "Первое число больше второго." << endl;  // Выводим сообщение о том, что первое число больше второго
    }

    return 0;  // Завершаем выполнение программы
}
