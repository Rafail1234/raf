#include <iostream>          // подключаем библиотеку для ввода и вывода
using namespace std;         // чтобы не писать std:: каждый раз

int main() {
	setlocale(LC_ALL,"Russian");
	int N, k;                // N - до какого числа считаем, k - степень
	cout << "Введите число N: ";
	cin >> N;                // вводим верхнюю границу суммы
	cout << "Введите степень k: ";
	cin >> k;                // вводим степень
	
	long long sum = 0;       // переменная для хранения итоговой суммы
	
	// цикл от 1 до N
	for (int i = 1; i <= N; i++) {
		long long p = 1;     // сюда будем сохранять i^k
		
		// второй цикл, чтобы посчитать i в степени k вручную
		for (int j = 0; j < k; j++) {
			p *= i;          // умножаем i на себя k раз
		}
		
		sum += p;            // добавляем i^k к общей сумме
	}
	
	// выводим результат
	cout << "Сумма равна: " << sum << endl;
	
	return 0;                // программа завершилась успешно
}
