#include <iostream>   // Подключаем библиотеку для работы с вводом/выводом (cin, cout)
#include <cmath>      // Подключаем библиотеку для математических функций (например, pow)
using namespace std;  // Чтобы не писать std:: каждый раз перед cin и cout

int main() {          // Главная функция программы, с неё начинается выполнение
    int N, k;         // Объявляем переменные N (число до которого суммируем) и k (степень)
    cout << "Введите N и k: ";  // Сообщение для пользователя
    cin >> N >> k;    // Ввод значений N и k с клавиатуры

    long long sum = 0;   // Переменная для хранения суммы (long long — чтобы влезали большие числа)

    // Цикл от 1 до N включительно
    for (int i = 1; i <= N; i++) {
        sum += pow(i, k);   // pow(i, k) — возводим i в степень k и прибавляем к sum
    }

    // Выводим результат
    cout << "Сумма: " << sum << endl;

    return 0;  // Завершаем программу (возврат 0 означает успешное выполнение)
}
