#include <iostream>
#include <math.h>
using namespace std;
class Number {;
public:
	
	int number;
	int result = 0;
void train(){
	if(number > 36)
		cout << "нет такого места в вагоне"<< endl;
	else{
		result = (number/4)+1;
	}
}
void print()
	{
		cout << "Результат: "<< result;
	}
};
int main()
{
	setlocale(LC_ALL, "Russian");
	Number num;
	num.number = 124;
	num.train();
	num.print();

	
}
