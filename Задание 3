#include <iostream>   // Подключаем библиотеку для работы с вводом/выводом (cin, cout)
using namespace std;  // Чтобы не писать std:: перед cin и cout

int main() {          // Главная функция, с неё начинается выполнение программы
    int a, b;         // Объявляем две переменные для хранения введённых чисел
    cout << "Введите два числа: ";  // Сообщение пользователю
    cin >> a >> b;    // Считываем два числа с клавиатуры и сохраняем в переменные a и b

    // Проверка условий:
    if (a == b)                        // Если a равно b
        cout << "Числа равны" << endl; // Выводим сообщение "Числа равны"
    else if (a < b)                                   // Иначе, если a меньше b
        cout << "Первое число меньше второго" << endl;// Выводим сообщение
    else                                              // Во всех других случаях (значит a > b)
        cout << "Первое число больше второго" << endl;// Выводим сообщение

    return 0;  // Завершение программы (0 — успешное выполнение)
}
