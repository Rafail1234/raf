#include <iostream>  // Подключаем библиотеку для ввода/вывода
using namespace std;  // Используем пространство имен std для упрощения записи

// Функция для вычисления степени числа
double power(double base, int exp) {
    double result = 1;  // Переменная для хранения результата (начальное значение = 1)

    // Если степень положительная
    if (exp > 0) {
        // Проходим по циклу exp раз и умножаем result на base
        for (int i = 0; i < exp; i++) {
            result *= base;  // Умножаем результат на основание
        }
    } 
    // Если степень отрицательная
    else if (exp < 0) {
        // Проходим по циклу -exp раз (то есть по модулю отрицательной степени)
        for (int i = 0; i < -exp; i++) {
            result *= base;  // Умножаем результат на основание
        }
        // Для отрицательной степени нужно взять обратную величину
        result = 1.0 / result;  // Инвертируем результат, чтобы получить 1 / base^(-exp)
    }
    
    // Если степень равна нулю, возвращается 1 (по определению степени)
    // В данном случае мы это не учитываем, так как 0 не вызывает ошибок в цикле.

    return result;  // Возвращаем результат вычисления
}

int main() {
    double a;  // Переменная для основания степени
    int b;     // Переменная для степени

    // Запрашиваем у пользователя ввод числа и степени
    cout << "Введите число и степень: ";
    cin >> a >> b;  // Считываем введенные значения

    // Выводим результат вычисления
    cout << a << "^" << b << " = " << power(a, b) << endl;

    return 0;  // Завершаем программу
}
