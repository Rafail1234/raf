#include <iostream>
using namespace std;

int main() {
	setlocale(LC_ALL, "Russian");
	
	int a, b, c;
	
	cout << "Введите первое число: ";
	cin >> a;
	cout << "Введите второе число: ";
	cin >> b;
	cout << "Введите третье число: ";
	cin >> c;
	
	// если есть равные числа, увеличиваем все на 5
	if (a == b|| a == c|| b == c) {
		a += 5;
		b += 5;
		c += 5;
	}
	
	cout << "Первое число: " << a << endl;
	cout << "Второе число: " << b << endl;
	cout << "Третье число: " << c << endl;
	
	return 0;
} 
