#include <iostream>   // Подключаем библиотеку для ввода и вывода (cin, cout)
using namespace std;  // Чтобы не писать std:: перед cin, cout

int main(){
	
	int a, b, c;  // Объявляем три переменные для хранения чисел, введённых пользователем
	
	cout << "Введите три числа: ";  // Сообщение для пользователя
	cin >> a >> b >> c; // Считываем три числа с клавиатуры
	
	// Проверяем, есть ли среди чисел хотя бы две равные
	if (a == b|| b == c|| a == c) {
		// Если есть равные числа, увеличиваем все три на 5
		a += 5;
		b += 5;
		c += 5;
	}
	
	cout << "Результат: " << a << " " << b << " " << c << endl;  // Выводим результат
	
	return 0;  // Завершаем программу
}
