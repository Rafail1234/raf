#include <iostream>
#include <string>
using namespace std;

struct Event {
	string name;
	int y,m,d,sh,sm,eh,em;
};

int main() {
	setlocale(LC_ALL, "Russian");
	int n; 
	cout << "Сколько мероприятий?: "; 
	cin >> n;
	Event e[100]; 
	cin.ignore();
	
	for(int i=0;i<n;i++){
		cout << "\nНазвание мероприятия: "; getline(cin,e[i].name);
		cout << "Дата (год месяц день): "; cin >> e[i].y >> e[i].m >> e[i].d;
		cout << "Время начала (часы минуты): "; cin >> e[i].sh >> e[i].sm;
		cout << "Время конца (часы минуты): "; cin >> e[i].eh >> e[i].em;
		cin.ignore();
	}
	
	for(int i=0;i<n-1;i++)
		for(int j=0;j<n-1-i;j++){
			bool swapNeeded = false;
			if (e[j].y>e[j+1].y) swapNeeded=true;
			else if(e[j].y==e[j+1].y && e[j].m>e[j+1].m) swapNeeded=true;
			else if(e[j].y==e[j+1].y && e[j].m==e[j+1].m && e[j].d>e[j+1].d) swapNeeded=true;
			else if(e[j].y==e[j+1].y && e[j].m==e[j+1].m && e[j].d==e[j+1].d &&
				(e[j].sh>e[j+1].sh || (e[j].sh==e[j+1].sh && e[j].sm>e[j+1].sm))) swapNeeded=true;
			if(swapNeeded) swap(e[j], e[j+1]);
		}
	
	cout << "\n--- Список мероприятий ---\n";
	for(int i=0;i<n;i++)
		cout << e[i].name << " | " << e[i].d<<"."<<e[i].m<<"."<<e[i].y
		<< " | "<<e[i].sh<<":"<<e[i].sm<<" - "<<e[i].eh<<":"<<e[i].em<<endl;
	
	cout << "\n--- Пересечения и максимальные промежутки ---\n";
	for(int i=0;i<n;){
		int j=i; while(j<n && e[j].y==e[i].y && e[j].m==e[i].m && e[j].d==e[i].d) j++;
		bool overlap=false; int maxGap=0; string gapBetween;
		for(int k=i;k<j-1;k++){
			int endCur = e[k].eh*60 + e[k].em, startNext = e[k+1].sh*60 + e[k+1].sm;
			if(startNext<endCur){ cout<<e[k].name<<" пересекается с "<<e[k+1].name<<endl; overlap=true;}
			int gap = startNext - endCur;
			if(gap>maxGap){ maxGap=gap; gapBetween=e[k].name+" и "+e[k+1].name;}
		}
		if(!overlap) cout<<"На дату "<<e[i].d<<"."<<e[i].m<<"."<<e[i].y<<" пересечений нет\n";
		if(maxGap>0) cout<<"Максимальный свободный промежуток: "<<maxGap<<" минут между "<<gapBetween<<endl;
		else cout<<"Свободного времени на эту дату нет\n";
		i=j;
	}
}
