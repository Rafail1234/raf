#include <iostream>
#include <cstdlib>  
#include <ctime>  
using namespace std;

int main() {
	setlocale(LC_ALL,"Russian");
	
	int n;
	cout << "Введите размер массива: ";
	cin >> n;
	
	// Выделение памяти под массив с помощью malloc
	int* arr = (int*)malloc(n * sizeof(int));
	if (arr == nullptr) {
		cerr << "Ошибка выделения памяти!\n";
		return 1;
	}
	
	srand((unsigned)time(nullptr));
	
	// Заполнение массива случайными числами
	for (int i = 0; i < n; i++) {
		arr[i] = rand() % 100; // числа от 0 до 99
	}
	
	cout << "Исходный массив:\n";
	for (int i = 0; i < n; i++) {
		cout << arr[i] << " ";
	}
	cout << "\n";
	
	// Пример изменения размера массива через realloc
	int newSize;
	cout << "Введите новый размер массива: ";
	cin >> newSize;
	
	int* temp = (int*)realloc(arr, newSize * sizeof(int));
	if (temp == nullptr) {
		cerr << "Ошибка перевыделения памяти!\n";
		free(arr); // освобождаем старый массив
		return 1;
	}
	arr = temp;
	
	// Заполняем новые элементы случайными числами (если размер увеличился)
	if (newSize > n) {
		for (int i = n; i < newSize; i++) {
			arr[i] = rand() % 100;
		}
	}
	
	cout << "Массив после изменения размера:\n";
	for (int i = 0; i < newSize; i++) {
		cout << arr[i] << " ";
	}
	cout << "\n";
	
	// Освобождение памяти
	free(arr);
	
	return 0;
}
