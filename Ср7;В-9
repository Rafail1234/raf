#include <iostream>
using namespace std;

int main() {
	setlocale(LC_ALL,"Russian");
	char s[100];
	cout << "Введите строку: ";
	cin >> s;
	
	int count = 0;
	int len = 0;
	while (s[len] != '\0') {
		len++;
	}
	
	for (int i = 0; i <= len - 3; i++) {
		if (s[i] == 'a' && s[i+1] == 'b' && s[i+2] == 'c') {
			count++;
		}
	}
	
	cout << "Количество 'abc': " << count << endl;
	return 0;
}
