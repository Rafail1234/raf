#include <iostream>       // подключаем библиотеку для ввода/вывода
using namespace std;      // чтобы не писать std:: перед cout и cin

int main() {
	setlocale(LC_ALL, "Russian");
	int number;           // создаём переменную для трёхзначного числа
	
	// Просим пользователя ввести трёхзначное число
	cout << "Введите трёхзначное число: ";
	cin >> number;        // считываем число с клавиатуры
	
	// Разбиваем число на цифры
	int a = number / 100;       // сотни
	int b = (number / 10) % 10; // десятки
	int c = number % 10;        // единицы
	
	// Ищем наименьшую цифру
	int min = a;                // предполагаем, что сотни — минимальные
	if (b < min) min = b;       // сравниваем с десятками
	if (c < min) min = c;       // сравниваем с единицами
	
	// Ищем наибольшую цифру
	int max = a;                // предполагаем, что сотни — максимальные
	if (b > max) max = b;       // сравниваем с десятками
	if (c > max) max = c;       // сравниваем с единицами
	
	// Выводим результаты
	cout << "Наименьшая цифра: " << min << endl;
	cout << "Наибольшая цифра: " << max << endl;
	
	return 0;                   // программа завершилась успешно
}
