#include <iostream>   // Подключаем библиотеку для работы с вводом и выводом (cin, cout)
using namespace std;  // Чтобы не писать std:: перед cin, cout, endl

int main() {          // Главная функция программы
    int num;          // Переменная для хранения введённого числа
    cout << "Введите трёхзначное число: ";  // Просим пользователя ввести число
    cin >> num;       // Считываем число с клавиатуры и сохраняем в переменную num

    // Разбиваем число на отдельные цифры:
    int d1 = num / 100;       // Первая цифра (сотни). Например, 348 / 100 = 3
    int d2 = (num / 10) % 10; // Вторая цифра (десятки). Например, 348 / 10 = 34 → 34 % 10 = 4
    int d3 = num % 10;        // Третья цифра (единицы). Например, 348 % 10 = 8

    // Находим минимальную и максимальную цифру
    int minDigit = min(d1, min(d2, d3));  // сравниваем три цифры и берём самую маленькую
    int maxDigit = max(d1, max(d2, d3));  // сравниваем три цифры и берём самую большую

    // Выводим результат
    cout << "Минимальная цифра: " << minDigit << endl;
    cout << "Максимальная цифра: " << maxDigit << endl;

    return 0;   // Завершение программы (0 — успешное выполнение)
}
