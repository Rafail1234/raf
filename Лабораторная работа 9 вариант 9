#include <iostream>   // для ввода/вывода
#include <fstream>    // для работы с файлами
#include <cstdlib>    // для rand(), srand()
#include <ctime>      // для time()
using namespace std;

int main() {
	setlocale(LC_ALL, "Russian"); // чтобы корректно отображался русский текст
	
	int N;  // переменная для количества чисел
	cout << "Введите количество чисел: ";
	cin >> N;  // ввод числа пользователем
	
	srand(time(0)); // инициализация генератора случайных чисел
	
	// 1. Создание первого файла и запись N случайных чисел
	ofstream f1("file1.txt");  // создаём файл для записи
	for(int i = 0; i < N; i++) {
		f1 << rand() % 10 + 1 << " "; // записываем случайное число от 1 до 10
	}
	f1.close();  // закрываем файл
	
	// 2. Чтение чисел из первого файла в динамический массив
	ifstream f2("file1.txt");  // открываем файл для чтения
	int* arr = new int[N];      // создаём динамический массив для хранения чисел
	for(int i = 0; i < N; i++) {
		f2 >> arr[i];           // читаем числа из файла
	}
	f2.close();  // закрываем файл
	
	// 3. Создание второго файла и запись последовательных произведений
	ofstream f3("file2.txt");  // создаём второй файл
	long long p = 1;           // переменная для хранения произведения чисел
	for(int i = 0; i < N; i++) {
		p *= arr[i];           // умножаем на текущий элемент массива
		f3 << p << " ";        // записываем результат в файл
	}
	f3.close();  // закрываем второй файл
	
	// 4. Освобождение динамической памяти
	delete[] arr;
	
	cout << "Файлы созданы и обработаны!" << endl;  // сообщение о завершении
	
	return 0;  // программа завершилась успешно
}
  
