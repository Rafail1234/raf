#include <iostream>
#include <fstream>
#include <cstdlib>
#include <ctime>
using namespace std;

int main() {
	setlocale(LC_ALL, "Russian");
	srand(time(0));
	
	int n;
	cout << "N = ";
	cin >> n;
	
	// Запись случайных чисел в файл
	ofstream f1("input.txt");
	for (int i = 0; i < n; i++) {
		f1 << rand() % 10 + 1 << " "; // числа от 1 до 10
	}
	f1.close();
	
	// Чтение и запись произведений
	ifstream f2("input.txt");
	ofstream f3("output.txt");
	
	long long pr = 1;
	int x;
	for (int i = 0; i < n; i++) {
		f2 >> x;
		pr = pr * x;
		f3 << pr << " ";
	}
	
	f2.close();
	f3.close();
	
	cout << "Готово. Результат в output.txt\n";
	return 0;
}
