#include <iostream>
#include <cstdlib>
#include <ctime>
#include <algorithm>
using namespace std;

int main() {
 int size;
 cout << "Введите размер массива: ";
 cin >> size;
 
 int* arr = new int[size];
 
 srand(std::time(0));
 
 for (int i = 0; i < size; ++i) {
  arr[i] = std::rand() % 100; 
 }
 
 cout << "Исходный массив: ";
 for (int i = 0; i < size; ++i) {
 cout << arr[i] << " ";
 }
 cout << std::endl;
 
 sort(arr, arr + size, [](int a, int b) {
  return a > b;
 });
 
 cout << "Отсортированный массив: ";
 for (int i = 0; i < size; ++i) {
 cout << arr[i] << " ";
 }
 cout << std::endl;
 
 delete[] arr;
 
 return 0;
}
