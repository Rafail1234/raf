#include <iostream>  // Подключение библиотеки для ввода/вывода
#include <cstdlib>   // Подключение библиотеки для работы с rand(), srand()
#include <ctime>     // Подключение библиотеки для работы с time()
#include <algorithm> // Подключение библиотеки для функции sort()

using namespace std; // Для удобства использования стандартных функций без префикса std::

int main() {
	int size;  // Объявляем переменную для размера массива
	cout << "Введите размер массива: "; // Запрос пользователю на ввод размера массива
	cin >> size; // Ввод размера массива
	
	int* arr = new int[size];  // Выделяем динамическую память для массива размера 'size'
	
	srand(time(0));  // Инициализация генератора случайных чисел с текущим временем как начальным значением
	
	// Заполнение массива случайными числами от 0 до 99
	for (int i = 0; i < size; ++i) {
		arr[i] = rand() % 100; // Генерация случайного числа от 0 до 99 и сохранение в массив
	}
	
	cout << "Исходный массив: "; // Вывод сообщения для начала вывода исходного массива
	for (int i = 0; i < size; ++i) {
		cout << arr[i] << " ";  // Вывод каждого элемента массива через пробел
	}
	cout << std::endl;  // Переход на новую строку после вывода массива
	
	// Сортировка массива в порядке убывания
	sort(arr, arr + size, [](int a, int b) {
		return a > b; // Лямбда-функция для сортировки в обратном порядке (от большего к меньшему)
	});
	
	cout << "Отсортированный массив: "; // Вывод сообщения для начала вывода отсортированного массива
	for (int i = 0; i < size; ++i) {
		cout << arr[i] << " ";  // Вывод каждого элемента отсортированного массива
	}
	cout << endl;  // Переход на новую строку после вывода массива
	
	delete[] arr;  // Освобождение динамически выделенной памяти
	
	return 0; // Завершение программы
}
